{
  "name": "drive3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "test:sim": "tsx scripts/sim-test.ts && tsx scripts/vehicle-test.ts && tsx scripts/visual-test.ts && tsx scripts/admin-test.ts && tsx scripts/keyboard-test.ts && tsx scripts/track-test.ts && tsx scripts/hud-test.ts && tsx scripts/phase3-test.ts && tsx scripts/weather-test.ts && tsx scripts/autobahn-test.ts && tsx scripts/world-test.ts && tsx scripts/traffic-test.ts && tsx scripts/city-test.ts",
    "test:autobahn": "tsx scripts/autobahn-test.ts --long",
    "test:world": "tsx scripts/world-test.ts",
    "test:traffic": "tsx scripts/traffic-test.ts",
    "test:longrun": "tsx scripts/autobahn-longrun.ts",
    "test:city": "tsx scripts/city-test.ts",
    "test:track": "tsx scripts/track-test.ts --lap",
    "build:track": "tsx scripts/build-nordschleife.ts",
    "prepare:cars": "tsx scripts/prepare-cars.ts",
    "prepare:traffic": "tsx scripts/prepare-traffic.ts",
    "prepare:city": "tsx scripts/prepare-city.ts",
    "bench": "tsx scripts/bench.ts",
    "make:test-model": "tsx scripts/make-test-model.ts",
    "handling": "tsx scripts/handling-report.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "meshoptimizer": "^1.1.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
